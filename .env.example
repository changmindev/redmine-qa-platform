# ============================================================
#  이 파일을 `.env` 로 복사한 뒤 값을 채우세요.   copy .env.example .env
#  .env 는 .gitignore 에 있어 커밋되지 않습니다. 비밀값을 코드에 넣지 마세요.
# ============================================================

# ── Redmine (필수) ──────────────────────────────────────────
REDMINE_URL=https://redmine.example.com
# Redmine 로그인 → 우측 상단 내 계정 → "API 액세스 키"
# 결함 등록 기능을 쓰려면 이 키에 '이슈 생성' 권한이 있어야 합니다.
REDMINE_API_KEY=
# 프로젝트 페이지 URL 의 영문 ID (.../projects/my-project → my-project)
REDMINE_PROJECT_ID=my-project

# 사내 자체서명 인증서 등으로 SSL 검증에 실패하면 false (권장하지 않음)
# REDMINE_VERIFY_SSL=true
# REDMINE_HTTP_TIMEOUT=30
# REDMINE_PAGE_SIZE=100

# ── Claude (테스트케이스 생성) ──────────────────────────────
# 비워두면 로컬에 설치·로그인된 `claude` CLI(Claude Pro/Max 구독 인증)를 사용합니다.
# 종량제 API 를 쓰려면 https://console.anthropic.com 에서 발급한 키(sk-ant-...)를 넣으세요.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MAX_TOKENS=16000
# ANTHROPIC_EFFORT=high          # low | medium | high | xhigh | max
# CLAUDE_CLI=claude
# CLAUDE_CLI_TIMEOUT=300

# ── 기획서 첨부 ─────────────────────────────────────────────
# Figma 주소를 읽으려면 개인 액세스 토큰이 필요합니다(없으면 파일 첨부만 동작).
# Figma > Settings > Security > Personal access tokens 에서 발급 (figd_... 형태)
FIGMA_TOKEN=
# 첨부 파일 1개당 최대 크기(MB)
# MAX_UPLOAD_MB=10

# ── 도메인 규칙 (Redmine 설정과 '정확히' 일치해야 집계됩니다) ──
STATUS_NEW=신규
STATUS_PROGRESS=진행중
STATUS_RESOLVED=작업완료
STATUS_QA=완료(Dev-QA)
# 버그로 집계할 트래커 이름들(쉼표 구분)
BUG_TRACKERS=버그,Bug,결함,Defect
# 실패 케이스를 이슈로 등록할 때 사용할 트래커명
DEFECT_TRACKER_NAME=결함
# 장기 미해결 이슈 기준일 (생성 후 N일 이상 & 미완료)
LONG_TERM_DAYS=14
# 한 번에 이 수를 넘겨 선택하면 "오래 걸린다" 경고를 띄우는 임계값
TESTCASE_MAX_ISSUES=20

# ── 앱 동작 ─────────────────────────────────────────────────
# DATA_DIR=./data
# REPORT_OUTPUT_DIR=./reports
# DISPLAY_TIMEZONE=Asia/Seoul
# CACHE_TTL_SECONDS=600
# CACHE_MAX_ENTRIES=64
# HOST=127.0.0.1
# PORT=5000
# FLASK_DEBUG=false
# LOG_LEVEL=INFO
